1:[["$","link",null,{"rel":"stylesheet","href":"/assets/release-1.0.css"}],["$","main",null,{"className":"subpage","children":[["$","header",null,{"className":"site-header","children":[["$","a",null,{"className":"brand","href":"/","aria-label":"Ocarina Reframed home","children":[["$","span",null,{"children":["Ocarina ",["$","b",null,{"children":["Reframed"]}]]}]]}],["$","nav",null,{"aria-label":"Main navigation","children":[["$","a",null,{"href":"/features","children":["Features"]}],["$","a",null,{"href":"/install","children":["Install"]}],["$","a",null,{"href":"/download","children":["Download"]}]]}],["$","a",null,{"className":"header-download","href":"/download/","children":["Download ",["$","span",null,{"children":["v1.0"]}]]}]]}],["$","section",null,{"className":"subpage-hero","children":[["$","div",null,{"className":"section","children":[["$","div",null,{"className":"section-kicker","children":["Ocarina Reframed features"]}],["$","h1",null,{"children":["One adventure. Two ways to play."]}],["$","p",null,{"children":["Ocarina Reframed moves touch-screen essentials into the main view and onto physical controls while preserving the original game’s progression, balance, inventory rules, and save data."]}],["$","div",null,{"className":"page-actions","children":[["$","a",null,{"className":"button button-gold","href":"/download","children":["Download v1.0 →"]}],["$","a",null,{"className":"button button-outline","href":"/install","children":["Read the install guide"]}]]}]]}]]}],["$","section",null,{"className":"section subpage-content","children":[["$","a",null,{"className":"back-link","href":"/","children":["← Back to Ocarina Reframed"]}],["$","div",null,{"className":"page-lead","children":[["$","h2",null,{"children":["Native presentation. Modern control."]}],["$","p",null,{"children":["The interface reads live game state and renders through OoT3D’s native HUD. Equipped items, action text, ammo, health, magic, and rupees remain synchronized with the game instead of being simulated by an external overlay."]}]]}],["$","div",null,{"className":"page-grid edition-grid","children":[["$","article",null,{"className":"info-card","children":[["$","h2",null,{"children":["Single Screen"]}],["$","p",null,{"children":["Redesigned file selection, Items, Gear, Map, and Songs on the main screen, with item previews, descriptions, and live controller assignments."]}]]}],["$","article",null,{"className":"info-card","children":[["$","h2",null,{"children":["Dual Screen"]}],["$","p",null,{"children":["The original two-screen experience with the modern HUD and free camera. Keep the familiar layout on dual-screen devices."]}]]}]]}],["$","div",null,{"className":"page-grid","children":[["$","article",null,{"className":"info-card","children":[["$","h2",null,{"children":["Live single-screen HUD"]}],["$","p",null,{"children":["See action prompts, equipped items, ammo, health, magic, rupees, and the minimap together without relying on the original touch-screen layout."]}]]}],["$","article",null,{"className":"info-card","children":[["$","h2",null,{"children":["Physical item shortcuts"]}],["$","p",null,{"children":["Use the D-pad for Item I, Item II, Navi/View, and the Ocarina. The Select button opens the Items screen."]}]]}],["$","article",null,{"className":"info-card","children":[["$","h2",null,{"children":["C-stick free camera"]}],["$","p",null,{"children":["Look around freely with adjustable sensitivity and inversion controls, based on Roberto-Nessy’s standalone OoT3D free-camera work."]}]]}],["$","article",null,{"className":"info-card","children":[["$","h2",null,{"children":["Adjustable HUD scale"]}],["$","p",null,{"children":["Cycle among 75%, 100%, 125%, and hidden HUD modes with L + R + ZR."]}]]}],["$","article",null,{"className":"info-card","children":[["$","h2",null,{"children":["Improved fonts"]}],["$","p",null,{"children":["Dialogue, prompts, and file names are clearer in the USA and Europe releases while preserving the game’s visual character."]}]]}],["$","article",null,{"className":"info-card","children":[["$","h2",null,{"children":["Regional support"]}],["$","p",null,{"children":["Supports USA Rev 1, Europe Rev 1, Japan Rev 1, Taiwan, and Korea, including Normal and Master Quest."]}]]}],["$","article",null,{"className":"info-card","children":[["$","h2",null,{"children":["Texture-pack friendly"]}],["$","p",null,{"children":["No 4K texture pack is required. To use one, keep its texture directory without installing its bundled code mod."]}]]}]]}]]}]]}]]
